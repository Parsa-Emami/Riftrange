    "schemas": {
      "EventEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "specversion",
          "id",
          "source",
          "type",
          "time",
          "subject",
          "data"
        ],
        "properties": {
          "specversion": {
            "type": "string",
            "const": "1.0"
          },
          "id": {
            "type": "string",
            "minLength": 16
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "lab.requested.v1",
              "lab.provisioning_started.v1",
              "lab.observed_state_changed.v1",
              "lab.reconciled.v1",
              "lab.terminated.v1",
              "agent.enrolled.v1",
              "agent.heartbeat_received.v1",
              "runtime.lease_expired.v1"
            ]
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "subject": {
            "type": "string"
          },
          "traceparent": {
            "type": [
              "string",
              "null"
            ]
          },
          "datacontenttype": {
            "type": "string",
            "const": "application/json"
          },
          "data": {
            "type": "object"
          }
        }
      }
    }
